# Copy to .env.local for local server-mode testing, or set in Vercel → Settings → Environment Variables.

# Turso (libSQL). Absent = the app runs in local mode (browser storage only).
# Local test DB: TURSO_DATABASE_URL=file:./local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Single-user gate. Required whenever TURSO_DATABASE_URL is set.
APP_PASSPHRASE=

# Cookie signing secret: openssl rand -hex 32
SESSION_SECRET=
